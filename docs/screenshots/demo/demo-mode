#!/usr/bin/env python3
"""Demo mode for screenshots of the public repo.

  demo-mode on    patch the installed Graphite plugins to show made-up data
  demo-mode off   restore the installed plugins from the repo

"on" edits only the copies in ~/.config/omarchy/plugins, never the repo
files. Network and device names map to made-up names, addresses to
10.0.0.x, the Wi-Fi QR code to a made-up network, and the Claude plan to
"pro". Run `omarchy restart shell` after each change.
"""
import os, shutil, sys

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
SRC = os.path.join(REPO, "files", ".config", "omarchy", "plugins")
DST = os.path.expanduser("~/.config/omarchy/plugins")
PLUGINS = ["graphite.network", "graphite.bluetooth", "graphite.speedtest", "graphite.wifiqr", "graphite.agents"]

NETWORKS = ["Studio Wi-Fi", "Guest", "Cafe Corner", "Library 5G", "Printer-Direct", "Loft",
            "Workshop", "Garden", "Office 2.4", "Corner Shop", "Home 5G", "Upstairs",
            "Bakery Free", "Harbor", "Maple", "North Wing", "Atelier", "Orchard", "Lab", "Transit",
            "Riverside", "Signal Box", "Hallway", "Rooftop"]
DEVICES = ["AirPods Pro", "MX Keys", "MX Master 3S", "Studio Speaker", "Desk Lamp", "Game Controller",
           "Headphones", "Printer", "Watch", "Tablet", "Phone", "Car Audio"]

# A JS function added to each patched panel: the same real name always gets
# the same made-up name.
def demo_fn(names):
    return """
  // DEMO MODE (docs/screenshots/demo/demo-mode): made-up names.
  // The counter lives in the map: changing it must not re-run bindings.
  property var demoMap: ({ "": 0 })
  function demoName(real) {
    var key = String(real || "")
    if (key === "") return key
    if (root.demoMap[key] === undefined) { root.demoMap[key] = root.demoMap[""]; root.demoMap[""] += 1 }
    var names = %s
    return names[root.demoMap[key] %% names.length]
  }
""" % repr(names).replace("'", '"')

PATCHES = {
    "graphite.network/Panel.qml": [
        ("  property var info: ({})", "  property var info: ({})" + demo_fn(NETWORKS)),
        ('return root.info.ssid || "Wi-Fi"', 'return root.demoName(root.info.ssid) || "Wi-Fi"'),
        ('text: root.info.ip || "--"', 'text: root.info.ip ? "10.0.0.24" : "--"'),
        ('text: root.info.gateway || "--"', 'text: root.info.gateway ? "10.0.0.1" : "--"'),
        ('text: row.net ? (row.net.ssid || "Hidden") : ""', 'text: row.net ? (root.demoName(row.net.ssid) || "Hidden") : ""'),
    ],
    "graphite.bluetooth/Panel.qml": [
        ("  function deviceLabel(device) {\n    return Model.deviceLabel(device)",
         demo_fn(DEVICES) + "  function deviceLabel(device) {\n    return root.demoName(Model.deviceLabel(device))"),
    ],
    "graphite.speedtest/Panel.qml": [
        ("title: root.connectionName", 'title: root.connectionName ? "Studio Wi-Fi" : ""'),
    ],
    "graphite.wifiqr/Panel.qml": [
        ('? ["omarchy-network-qr", "--meta", requestedIface]\n      : ["omarchy-network-qr", "--meta"]',
         '? ["%s"]\n      : ["%s"]' % (os.path.join(HERE, "demo-qr"), os.path.join(HERE, "demo-qr"))),
    ],
    "graphite.agents/Panel.qml": [
        ("text: root.heroMeta(root.provider).toLowerCase()", 'text: root.heroMeta(root.provider) ? "pro" : ""'),
    ],
}

def restore():
    for p in PLUGINS:
        shutil.rmtree(os.path.join(DST, p))
        shutil.copytree(os.path.join(SRC, p), os.path.join(DST, p))

def on():
    restore()
    for rel, edits in PATCHES.items():
        path = os.path.join(DST, rel)
        text = open(path).read()
        for old, new in edits:
            if text.count(old) != 1:
                sys.exit("demo-mode: patch does not fit %s: %r" % (rel, old[:60]))
            text = text.replace(old, new)
        open(path, "w").write(text)

if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "on": on()
    elif mode == "off": restore()
    else: sys.exit(__doc__)
    print("demo mode " + mode + "; now run: omarchy restart shell")
