#!/usr/bin/env python3
"""Print the size and pressure of each trackpad touch when it lifts.

Use it to set libinput's palm limits (AttrPalmSizeThreshold,
AttrPalmPressureThreshold) in /etc/libinput/local-overrides.quirks: rest a
palm, then tap and drag with fingers, and compare the numbers. Needs read
access to /dev/input (the "input" group). Stop it with Ctrl+C.
Usage: trackpad-measure [seconds]
"""

import glob
import os
import select
import struct
import sys
import time

EV_KEY, EV_ABS, EV_SYN = 1, 3, 0
ABS_MT_SLOT, ABS_MT_TOUCH_MAJOR, ABS_MT_TOUCH_MINOR = 0x2F, 0x30, 0x31
ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID, ABS_MT_PRESSURE = 0x35, 0x36, 0x39, 0x3A
EVENT = struct.Struct("llHHi")



def find_trackpad():
    """The event device with multitouch positions and a two-finger tool."""
    best = None
    for path in sorted(glob.glob("/dev/input/event*")):
        name = os.path.basename(path)
        caps = f"/sys/class/input/{name}/device/capabilities"
        try:
            abs_bits = int("".join(open(f"{caps}/abs").read().split()), 16)
            key_words = open(f"{caps}/key").read().split()
            key_bits = int("".join(w.rjust(16, "0") for w in key_words), 16)
            label = open(f"/sys/class/input/{name}/device/name").read().strip()
        except (OSError, ValueError):
            continue
        if abs_bits >> ABS_MT_POSITION_X & 1 and key_bits >> 0x14D & 1:
            score = 1 + ("trackpad" in label.lower() or "touchpad" in label.lower())
            if not best or score > best[0]:
                best = (score, path, label)
    return (best[1], best[2]) if best else (None, None)


def main():
    path, label = find_trackpad()
    if not path:
        sys.exit("no trackpad found")
    limit = float(sys.argv[1]) if len(sys.argv) > 1 else None
    dev = os.open(path, os.O_RDONLY)
    print(f"{label} ({path}). Touch sizes are device units.", flush=True)
    print("start  duration  max_major  max_minor  max_pressure  x,y at start", flush=True)
    slots, slot, started = {}, 0, time.monotonic()
    buffer = b""
    while limit is None or time.monotonic() - started < limit:
        ready, _, _ = select.select([dev], [], [], 0.5)
        if not ready:
            continue
        buffer += os.read(dev, EVENT.size * 64)
        while len(buffer) >= EVENT.size:
            _, _, etype, code, value = EVENT.unpack_from(buffer)
            buffer = buffer[EVENT.size:]
            if etype != EV_ABS:
                continue
            if code == ABS_MT_SLOT:
                slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value < 0 and slot in slots:
                    t = slots.pop(slot)
                    now = time.monotonic()
                    print(f"{t['t'] - started:5.1f}  {now - t['t']:7.2f}s  {t['major']:9}  {t['minor']:9}  {t['pressure']:12}  {t['x']},{t['y']}", flush=True)
                elif value >= 0:
                    slots[slot] = {"t": time.monotonic(), "major": 0, "minor": 0, "pressure": 0, "x": None, "y": None}
            elif slot in slots:
                t = slots[slot]
                if code == ABS_MT_TOUCH_MAJOR:
                    t["major"] = max(t["major"], value)
                elif code == ABS_MT_TOUCH_MINOR:
                    t["minor"] = max(t["minor"], value)
                elif code == ABS_MT_PRESSURE:
                    t["pressure"] = max(t["pressure"], value)
                elif code == ABS_MT_POSITION_X and t["x"] is None:
                    t["x"] = value
                elif code == ABS_MT_POSITION_Y and t["y"] is None:
                    t["y"] = value


if __name__ == "__main__":
    main()
