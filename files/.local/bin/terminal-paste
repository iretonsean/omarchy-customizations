#!/bin/bash

# Paste into the focused terminal. An image on the clipboard is sent as Ctrl+V,
# because terminal agents such as Claude Code read clipboard images on Ctrl+V.
# Text is sent as Shift+Insert, the normal terminal paste.
#
# Super+V runs this in the background. It must never run inside Hyprland and
# make Hyprland wait: wl-paste needs Hyprland to answer, so that would deadlock.
# Processes that Hyprland starts ignore SIGTERM, so the timeout uses SIGKILL.
#
# Usage: terminal-paste [--dry-run]

if timeout -s KILL 1 wl-paste --list-types 2>/dev/null | grep -q '^image/'; then
  mods="CTRL"
  key="V"
else
  mods="SHIFT"
  key="Insert"
fi

if [[ $1 == "--dry-run" ]]; then
  echo "$mods+$key"
  exit 0
fi

hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"down\" })" >/dev/null
sleep 0.05
hyprctl dispatch "hl.dsp.send_key_state({ mods = \"$mods\", key = \"$key\", state = \"up\" })" >/dev/null
